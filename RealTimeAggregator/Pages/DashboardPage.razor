@page "/dashboard"
@using MudBlazor
@using RealTimeAggregator.Kafka.MessageProcessor
@using RealTimeAggregator.Kafka.Models
@inject MessageProcessor MessageProcessor

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <MudGrid>
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Elevation="2" Class="pa-4" Style="height: 100%;">
               @*  <SalesOverviewChart /> *@
                <h3>Sales Total</h3>
                <p>@_salesTotal.ToString("C")</p>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Elevation="2" Class="pa-4" Style="height: 100%;">
               @*  <ProductDistributionChart /> *@
                <h3>Purchase Total</h3>
                <p>@_purchaseTotal.ToString("C")</p>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Elevation="2" Class="pa-4" Style="height: 100%;">
                @* <TopPerformingProductsChart /> *@
                <h3>Profit</h3>
                <p>@_profit.ToString("C")</p>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Elevation="2" Class="pa-4" Style="height: 100%;">
                <AddNewSales />
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Elevation="2" Class="pa-4" Style="height: 100%;">
                <AddNewPurchase />
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Elevation="2" Class="pa-4" Style="height: 100%;">
                <AddNewProductForm />
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private decimal _salesTotal;
    private decimal _purchaseTotal;
    private decimal _profit;

    protected override void OnInitialized()
    {
        MessageProcessor.OnMessageProcessed += HandleMessageProcessed;
        MessageProcessor.Initialize();
    }

    private void HandleMessageProcessed(IKafkaMessage message)
    {
        switch (message)
        {
            case SalesMessage salesMessage:
                _salesTotal = salesMessage.TotalSales;
                break;
            case PurchaseMessage purchaseMessage:
                _purchaseTotal = purchaseMessage.TotalPurchases;
                break;
            case ProfitMessage profitMessage:
                _profit = profitMessage.NetProfit;
                break;
        }
        Console.WriteLine(message.ToString());
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        MessageProcessor.OnMessageProcessed -= HandleMessageProcessed;
    }
}