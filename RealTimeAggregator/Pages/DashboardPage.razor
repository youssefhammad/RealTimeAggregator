        new Product { Name = "Laptop", Sales = 10200 },
        new Product { Name = "Headphones", Sales = 8700 },
        new Product { Name = "Smartwatch", Sales = 7300 },
        new Product { Name = "Tablet", Sales = 6200 },
        new Product { Name = "Camera", Sales = 5100 },
    };

    // Form 1 Fields and Methods
    private MudForm _form1;
    private bool _form1IsValid;
    private string _form1Field1;
    private string _form1Field2;
    private int _form1Field3;

    private void OnForm1Submit()
    {
        // Handle Form 1 submission logic here
    }

    // Form 2 Fields and Methods
    private MudForm _form2;
    private bool _form2IsValid;
    private string _form2Field1;
    private string _form2Field2;
    private int _form2Rating;

    private void OnForm2Submit()
    {
        // Handle Form 2 submission logic here
    }

    // Form 3 Fields and Methods
    private MudForm _form3;
    private bool _form3IsValid;
    private string _form3Field1;
    private string _form3Field2;
    private string _form3Field3;
    private string _form3Field4;

    private void OnForm3Submit()
    {
        // Handle Form 3 submission logic here
    }
}