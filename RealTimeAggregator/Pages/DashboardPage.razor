@page "/dashboard"
@using MudBlazor

<div class="pa-4">
    <div class="grid-container" style="height: 100%;">
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
            <MudGrid Spacing="2" Style="height: 100%;">
                <MudItem xs="12" sm="4" md="4" Class="d-flex" Style="height: 50%;">
                    <SalesOverviewChart />
                </MudItem>
                <MudItem xs="12" sm="4" md="4" Class="d-flex" Style="height: 50%;">
                    <ProductDistributionChart />
                </MudItem>
                <MudItem xs="12" sm="4" md="4" Class="d-flex" Style="height: 50%;">
                    <TopPerformingProductsChart />
                </MudItem>
            </MudGrid>
        </MudContainer>

        <div class="grid-item d-flex" style="height: 50%;">
            <DummyForm1 />
        </div>

        <div class="grid-item d-flex" style="height: 50%;">
            <DummyForm2 />
        </div>

        <div class="grid-item d-flex" style="height: 50%;">
            <AddNewProductForm />
        </div>
    </div>
</div>

<style>
    .pa-4 {
        padding: 16px;
    }

    .grid-container {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
    }

    .grid-item {
        flex: 1 1 calc(33.333% - 16px);
        box-sizing: border-box;
    }
</style>