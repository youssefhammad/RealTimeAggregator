@page "/create-purchase"
@using RealTimeAggregator.Data.ProductsConfig.Models
@using RealTimeAggregator.Data.Purchase.Models
@using RealTimeAggregator.Services
@using RealTimeAggregator.Services.ProductsConfig.Interfaces
@inject IPurchaseService PurchaseService
@inject IProductService ProductService

<div class="form-box flex-grow-1">
    <h6 class="mb-2">Create New Purchase</h6>
    <EditForm Model="@purchaseModel" OnValidSubmit="HandleValidSubmit" class="d-flex flex-column">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <label for="supplierId">Supplier</label>
        <InputSelect id="supplierId" @bind-Value="purchaseModel.SupplierID" class="mb-2">
            <option value="">-- Select a Supplier --</option>
            @foreach (var supplier in suppliers)
            {
                <option value="@supplier.SupplierID">@supplier.SupplierName</option>
            }
        </InputSelect>

        <label for="orderDate">Order Date</label>
        <InputDate id="orderDate" @bind-Value="purchaseModel.OrderDate" class="mb-2" />

        <h6 class="mt-3">Order Details</h6>
        @foreach (var detail in orderDetails)
        {
            <div class="order-detail mb-2">
                <label>Product</label>
                <InputSelect Value="@detail.ProductID" ValueChanged="@((string value) => ProductChanged(detail, value))" ValueExpression="@(() => detail.ProductID)" class="mb-1">
                    <option value="">-- Select a Product --</option>
                    @foreach (var product in products)
                    {
                        <option value="@product.Id">@product.ProductName</option>
                    }
                </InputSelect>

                <label>Quantity</label>
                <InputNumber @bind-Value="detail.Quantity" min="1" class="mb-1" />

                <label>Price</label>
                <InputNumber @bind-Value="detail.Price" class="mb-1" />
            </div>
        }
        <button type="button" class="btn btn-secondary mt-2" @onclick="AddOrderDetail">Add Another Product</button>

        <button type="submit" class="mt-4 submit-button">Create Purchase</button>
    </EditForm>
</div>

@code {
    private PurchaseOrder purchaseModel = new PurchaseOrder();
    private List<PurchaseOrderDetail> orderDetails = new List<PurchaseOrderDetail>();
    private List<Supplier> suppliers = new List<Supplier>();
    private List<Product> products = new List<Product>();

    protected override async Task OnInitializedAsync()
    {
        suppliers = (await PurchaseService.GetAllSuppliersAsync()).ToList();
        products = (await ProductService.GetAllProductsAsync()).ToList();

        Console.WriteLine($"Loaded {suppliers.Count} suppliers and {products.Count} products");

        purchaseModel.OrderDate = DateTime.Now;
        orderDetails.Add(new PurchaseOrderDetail { Quantity = 1 });

        Console.WriteLine("Initialized PurchaseOrder with one OrderDetail");
    }

    private void AddOrderDetail()
    {
        orderDetails.Add(new PurchaseOrderDetail { Quantity = 1 });
        Console.WriteLine($"Added new OrderDetail. Total OrderDetails: {orderDetails.Count}");
    }

    private void ProductChanged(PurchaseOrderDetail detail, string newProductId)
    {
        detail.ProductID = newProductId;
        UpdateProductPrice(detail);
    }

    private void UpdateProductPrice(PurchaseOrderDetail detail)
    {
        Console.WriteLine($"Updating price for ProductID: {detail.ProductID}");

        var selectedProduct = products.FirstOrDefault(p => p.Id == detail.ProductID);
        if (selectedProduct != null)
        {
            detail.Price = selectedProduct.Price;
            Console.WriteLine($"Updated price to: {detail.Price}");
        }
        else
        {
            detail.Price = 0;
            Console.WriteLine($"Product not found for ID: {detail.ProductID}. Price set to 0.");
        }
        StateHasChanged(); // Ensure the UI updates
    }

    private void UpdateTotalAmount()
    {
        purchaseModel.TotalAmount = orderDetails.Sum(d => d.Quantity * d.Price);
        StateHasChanged();
    }

    private async Task HandleValidSubmit()
    {
        Console.WriteLine("HandleValidSubmit method called");

        if (purchaseModel.SupplierID == 0)
        {
            Console.WriteLine("Error: No supplier selected");
            return;
        }

        if (orderDetails.Any(d => string.IsNullOrEmpty(d.ProductID) || d.Quantity < 1))
        {
            Console.WriteLine("Error: Invalid order details");
            return;
        }

        try
        {
            Console.WriteLine("OrderDetails:");
            foreach (var detail in orderDetails)
            {
                Console.WriteLine($"ProductID: {detail.ProductID}, Quantity: {detail.Quantity}, Price: {detail.Price}");
            }

            UpdateTotalAmount();

            int newPurchaseId = await PurchaseService.CreateNewPurchaseAsync(
                purchaseModel.SupplierID,
                purchaseModel.OrderDate,
                orderDetails
            );

            purchaseModel = new PurchaseOrder { OrderDate = DateTime.Now };
            orderDetails = new List<PurchaseOrderDetail> { new PurchaseOrderDetail { Quantity = 1 } };
            Console.WriteLine($"New purchase created with ID: {newPurchaseId}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating purchase: {ex.Message}");
        }
    }
}