@page "/create-sale"
@using RealTimeAggregator.Data.ProductsConfig.Models
@using RealTimeAggregator.Data.Sales.Models
@using RealTimeAggregator.Services
@using RealTimeAggregator.Services.ProductsConfig.Interfaces
@inject ISalesService SalesService
@inject IProductService ProductService

<div class="form-box flex-grow-1">
    <h6 class="mb-2">Create New Sale</h6>
    <EditForm Model="@saleModel" OnValidSubmit="HandleValidSubmit" class="d-flex flex-column">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <label for="customerId">Customer</label>
        <InputSelect id="customerId" @bind-Value="saleModel.CustomerID" class="mb-2">
            <option value="">-- Select a Customer --</option>
            @foreach (var customer in customers)
            {
                <option value="@customer.Id">@customer.CustomerName</option>
            }
        </InputSelect>

        <label for="orderDate">Order Date</label>
        <InputDate id="orderDate" @bind-Value="saleModel.OrderDate" class="mb-2" />

        <h6 class="mt-3">Order Details</h6>
        @foreach (var detail in saleModel.OrderDetails)
        {
            <div class="order-detail mb-2">
                <label>Product</label>
                <InputSelect Value="@detail.ProductID" ValueChanged="@((string value) => ProductChanged(detail, value))" ValueExpression="@(() => detail.ProductID)" class="mb-1">
                    <option value="">-- Select a Product --</option>
                    @foreach (var product in products)
                    {
                        <option value="@product.Id">@product.ProductName</option>
                    }
                </InputSelect>

                <label>Quantity</label>
                <InputNumber @bind-Value="detail.Quantity" min="1" class="mb-1" />

                <label>Price</label>
                <InputNumber @bind-Value="detail.Price" class="mb-1" readonly />
            </div>
        }
        <button type="button" class="btn btn-secondary mt-2" @onclick="AddOrderDetail">Add Another Product</button>

        <button type="submit" class="mt-4 submit-button">Create Sale</button>
    </EditForm>
</div>

@code {
    private SaleModel saleModel = new SaleModel();
    private List<Customer> customers = new List<Customer>();
    private List<Product> products = new List<Product>();

    protected override async Task OnInitializedAsync()
    {
        customers = (await SalesService.GetAllCustomersAsync()).ToList();
        products = (await ProductService.GetAllProductsAsync()).ToList();

        Console.WriteLine($"Loaded {customers.Count} customers and {products.Count} products");

        saleModel.OrderDate = DateTime.Now;
        saleModel.OrderDetails.Add(new SalesOrderDetail { Quantity = 1 });

        Console.WriteLine("Initialized SaleModel with one OrderDetail");
    }

    private void AddOrderDetail()
    {
        saleModel.OrderDetails.Add(new SalesOrderDetail { Quantity = 1 });
        Console.WriteLine($"Added new OrderDetail. Total OrderDetails: {saleModel.OrderDetails.Count}");
    }

    private void ProductChanged(SalesOrderDetail detail, string newProductId)
    {
        detail.ProductID = newProductId;
        UpdateProductPrice(detail);
    }

    private void UpdateProductPrice(SalesOrderDetail detail)
    {
        Console.WriteLine($"Updating price for ProductID: {detail.ProductID}");

        var selectedProduct = products.FirstOrDefault(p => p.Id == detail.ProductID);
        if (selectedProduct != null)
        {
            detail.Price = selectedProduct.Price;
            Console.WriteLine($"Updated price to: {detail.Price}");
        }
        else
        {
            detail.Price = 0;
            Console.WriteLine($"Product not found for ID: {detail.ProductID}. Price set to 0.");
        }
        StateHasChanged(); // Ensure the UI updates
    }

    private async Task HandleValidSubmit()
    {
        Console.WriteLine("HandleValidSubmit method called");

        if (string.IsNullOrEmpty(saleModel.CustomerID.ToString()) || saleModel.CustomerID == 0)
        {
            Console.WriteLine("Error: No customer selected");
            return;
        }

        if (saleModel.OrderDetails.Any(d => string.IsNullOrEmpty(d.ProductID) || d.Quantity < 1))
        {
            Console.WriteLine("Error: Invalid order details");
            return;
        }

        try
        {
            Console.WriteLine("Product list:");
            foreach (var prod in products)
            {
                Console.WriteLine($"Product ID: {prod.Id}, Name: {prod.ProductName}, Price: {prod.Price}");
            }

            Console.WriteLine("OrderDetails:");
            foreach (var detail in saleModel.OrderDetails)
            {
                Console.WriteLine($"ProductID: {detail.ProductID}, Quantity: {detail.Quantity}, Price: {detail.Price}");
            }

            int newSaleId = await SalesService.CreateNewSaleAsync(
                saleModel.CustomerID,
                saleModel.OrderDate,
                saleModel.OrderDetails
            );

            saleModel = new SaleModel();
            Console.WriteLine($"New sale created with ID: {newSaleId}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating sale: {ex.Message}");
        }
    }

    private class SaleModel
    {
        public int CustomerID { get; set; }
        public DateTime OrderDate { get; set; }
        public List<SalesOrderDetail> OrderDetails { get; set; } = new List<SalesOrderDetail>();
    }
}